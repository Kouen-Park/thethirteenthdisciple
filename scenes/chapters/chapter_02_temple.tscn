[node name="ScatteredCoins" type="Area2D" parent="."]
position = Vector2(405, 585)
collision_layer = 2
monitorable = true
script = ExtResource("9_interactable")
interaction_id = &"scattered_coins"
prompt_text = "흩어진 동전 모아두기"
description = "동전은 흙먼지 속에 흩어져 있다. 발자국은 주변을 맴돌지만, 아직 아무도 손을 대지 않았다."
one_shot = true
interaction_data = {"dialogue": [{"speaker": "player", "text": "동전은 흙먼지 속에 흩어져 있다. 발자국은 주변을 맴돌지만, 아직 아무도 손을 대지 않았다."}, {"speaker": "player", "text": "몇 닢은 상 아래까지 굴러갔고, 몇 닢은 사람들이 급히 물러난 발자국에 반쯤 묻혔다."}, {"speaker": "player", "text": "돈을 빼앗으려 한 흔적이라기보다, 돈을 만질 틈도 없이 멈춘 자리처럼 보인다."}]}

