static func cutscene_shots(data: Dictionary) -> Array:
	return CUTSCENES.get(str(data.get("sequence", "")), [[str(data.get("scene", "")), str(data.get("text", ""))]]).duplicate(true)
const FICTION := "성경의 사건을 따라가는 창작 체험입니다. 주인공은 열두 사도에 추가된 인물이 아닙니다. 주민 대화, 물건 조사와 도움 행동은 창작이며 예수님의 체포·죽음·부활을 바꾸지 않습니다. 성경 인물의 말은 별도 인용 표시가 없으면 본문 내용을 바탕으로 한 요약·극화입니다."
