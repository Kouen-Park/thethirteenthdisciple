[node name="Miriam" type="Area2D" parent="."]
position = Vector2(1640, 635)
collision_layer = 2
monitorable = true
script = ExtResource("9_interactable")
interaction_id = &"miriam"
prompt_text = "미리암의 증언 듣기"
description = "당신도 왔군요. 돈이 없는 사람들은 여기서 늘 가장자리로 밀려났어요. 지금은 비로소 누구든 머물 수 있는 자리가 보여요."
one_shot = true
dim_on_use = false
interaction_data = {"dialogue": [{"speaker": "player", "text": "미리암, 당신은 이 일을 어떻게 보았습니까?"}, {"speaker": "target", "text": "사람들은 제물을 사려고 값을 묻고 또 물었어요. 기도하러 온 사람의 목소리는 그 사이에서 들리지 않았고요."}, {"speaker": "player", "text": "하지만 누군가는 오늘의 장사를 잃었습니다."}, {"speaker": "target", "text": "알아요. 그래도 지금은 돈이 없는 사람도 밀려나지 않고 머물 수 있는 자리가 보여요."}]}
metadata/display_name = "미리암"
metadata/head_offset = Vector2(0, -72)

