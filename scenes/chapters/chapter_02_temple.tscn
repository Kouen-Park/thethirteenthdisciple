[node name="TempleGuard" type="Area2D" parent="."]
position = Vector2(1160, 445)
collision_layer = 2
monitorable = true
script = ExtResource("9_interactable")
interaction_id = &"temple_guard"
prompt_text = "성전 경비의 증언 듣기 (선택)"
description = "누가 먼저 옳았는지는 내 일이 아니오. 나는 사람들이 또 몰려와 서로를 밀치기 시작할까 그게 걱정이오."
one_shot = true
dim_on_use = false
interaction_data = {"dialogue": [{"speaker": "player", "text": "경비가 본 일은 무엇입니까?"}, {"speaker": "target", "text": "고함이 들렸고 상이 넘어졌소. 상인들이 물러났고, 구경꾼은 더 가까이 몰려들었지."}, {"speaker": "player", "text": "누가 먼저 폭력을 시작했습니까?"}, {"speaker": "target", "text": "그보다 나는 사람들이 다시 서로를 밀치기 시작할까 걱정이오. 한 번 커진 군중은 누구의 말도 듣지 않으니."}]}
metadata/display_name = "성전 경비"
