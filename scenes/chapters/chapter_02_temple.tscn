[node name="MerchantJonah" type="Area2D" parent="."]
position = Vector2(610, 635)
collision_layer = 2
monitorable = true
script = ExtResource("9_interactable")
interaction_id = &"merchant_jonah"
prompt_text = "요나의 증언 듣기"
description = "또 왔군. 상을 뒤엎으면 그날 장사를 망치는 것으로 끝날 것 같나? 질서가 무너지면 그 다음 소란의 값도 우리 같은 상인이 치러."
one_shot = true
dim_on_use = false
interaction_data = {"dialogue": [{"speaker": "player", "text": "요나, 여기서 무슨 일이 있었습니까?"}, {"speaker": "target", "text": "또 왔군. 그 사람이 상들을 뒤엎었어. 사람들은 놀라 달아났고 장사는 그대로 끝났지."}, {"speaker": "player", "text": "기도할 자리를 되찾으려 했다는 말도 들었습니다."}, {"speaker": "target", "text": "뜻이 좋으면 질서를 깨도 되는 건가? 다음 소란의 값은 늘 우리 같은 사람이 치러."}]}
metadata/display_name = "상인 요나"
metadata/head_offset = Vector2(0, -72)

