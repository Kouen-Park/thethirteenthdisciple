[node name="EmptyTable" type="Area2D" parent="."]
position = Vector2(875, 535)
collision_layer = 2
monitorable = true
script = ExtResource("9_interactable")
interaction_id = &"empty_table"
prompt_text = "뒤집힌 상 옆으로 밀기"
description = "상판에는 급히 짚은 손바닥 자국이 남아 있다. 물건은 사라졌지만 나무는 아직 비스듬히 눌려 있다."
one_shot = true
interaction_data = {"dialogue": [{"speaker": "player", "text": "상판에는 급히 짚은 손바닥 자국이 남아 있다. 물건은 사라졌지만 나무는 아직 비스듬히 눌려 있다."}, {"speaker": "player", "text": "상을 다시 세우면 이 흔적을 지우게 된다. 그대로 둔 채 통로만 확보하자."}, {"speaker": "player", "text": "분노가 남긴 자리인지, 경고가 남긴 자리인지는 이것만으로 알 수 없다."}]}

