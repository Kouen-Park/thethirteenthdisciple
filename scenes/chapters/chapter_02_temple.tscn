[node name="PrayerCorner" type="Area2D" parent="."]
position = Vector2(1480, 520)
collision_layer = 2
monitorable = true
script = ExtResource("9_interactable")
interaction_id = &"prayer_corner"
prompt_text = "기도 자리의 천 펼치기"
description = "상인들의 목소리가 사라진 자리에 작은 기도 자리가 드러났다. 바닥에는 오래 머문 무릎 자국만 남아 있다."
one_shot = true
interaction_data = {"dialogue": [{"speaker": "player", "text": "상인들의 목소리가 사라진 자리에 작은 기도 자리가 드러났다."}, {"speaker": "player", "text": "벽 가까운 바닥에는 오래 머문 무릎 자국이 있고, 그 옆의 먼지만 조용히 가라앉아 있다."}, {"speaker": "player", "text": "이 자리는 새로 생긴 것이 아니다. 소음에 가려져 보이지 않았던 자리다."}]}

